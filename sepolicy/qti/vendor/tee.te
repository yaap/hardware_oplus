# Fingerprint
rw_dir_file(tee, vendor_persist_fingerprint_file)
rw_dir_file(tee, fingerprint_vendor_data_file)

allow tee vendor_gpt_block_device:blk_file read;
allow tee vendor_xbl_block_device:blk_file read;
allow tee boot_block_device:blk_file read;

allow tee face_vendor_data_file:dir create_dir_perms;
allow tee face_vendor_data_file:file create_file_perms;

allow tee vendor_data_file:dir rw_dir_perms;
allow tee vendor_data_file:file r_file_perms;
