type wlschgd, domain;
type wlschgd_exec, exec_type, vendor_file_type, file_type;
rw_dir_file(wlschgd, wlschgd_device)

allow wlschgd wlschgd_device:chr_file rw_file_perms;
allow wlschgd random_device:chr_file r_file_perms;
allow wlschgd kmsg_device:chr_file w_file_perms;

init_daemon_domain(wlschgd)
